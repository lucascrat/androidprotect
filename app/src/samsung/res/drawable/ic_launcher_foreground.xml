<?xml version="1.0" encoding="utf-8"?>
<!-- Samsung Calculator icon: dark + circle (top-left), dark - circle (bottom-left), green = pill (right) -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top dark circle (+ button) center=(30,30) r=22 -->
    <path
        android:fillColor="#2D2D2D"
        android:pathData="M30,8 A22,22 0 0,1 52,30 A22,22 0 0,1 30,52 A22,22 0 0,1 8,30 A22,22 0 0,1 30,8 Z"/>
    <!-- + horizontal -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M23,28.5 L37,28.5 L37,31.5 L23,31.5 Z"/>
    <!-- + vertical -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M28.5,23 L31.5,23 L31.5,37 L28.5,37 Z"/>

    <!-- Bottom dark circle (- button) center=(30,78) r=22 -->
    <path
        android:fillColor="#2D2D2D"
        android:pathData="M30,56 A22,22 0 0,1 52,78 A22,22 0 0,1 30,100 A22,22 0 0,1 8,78 A22,22 0 0,1 30,56 Z"/>
    <!-- - horizontal -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M23,76.5 L37,76.5 L37,79.5 L23,79.5 Z"/>

    <!-- Green pill (= button): x=56-96, y=10-98, corner-r=20 -->
    <path
        android:fillColor="#4CAF50"
        android:pathData="M76,10 Q96,10 96,30 L96,78 Q96,98 76,98 Q56,98 56,78 L56,30 Q56,10 76,10 Z"/>
    <!-- = top bar -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M63,47 L89,47 L89,51 L63,51 Z"/>
    <!-- = bottom bar -->
    <path android:fillColor="#FFFFFF"
          android:pathData="M63,57 L89,57 L89,61 L63,61 Z"/>

</vector>
